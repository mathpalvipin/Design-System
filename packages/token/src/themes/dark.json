{
  "color": {
    "bg": {
      "default": { "$value": "{color.gray.900}", "$type": "color" },
      "subtle":  { "$value": "{color.gray.800}", "$type": "color" },
      "muted":   { "$value": "{color.gray.700}", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "{color.gray.50}",  "$type": "color" },
      "secondary": { "$value": "{color.gray.300}", "$type": "color" },
      "inverse":   { "$value": "{color.gray.900}", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.gray.700}", "$type": "color" }
    },
    "action": {
      "primary":       { "$value": "{color.blue.500}", "$type": "color" },
      "primary-hover": { "$value": "{color.blue.400}", "$type": "color" },
      "danger":        { "$value": "{color.red.400}",  "$type": "color" }
    },
    "focus": {
      "ring": { "$value": "{color.blue.400}", "$type": "color" }
    }
  }
}